# SEVOLF Digital Environment Configuration Template
# Copy this file to .env.local and fill in the values

# Public Storefront Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="SEVOLF Digital"
NEXT_PUBLIC_SUPPORT_EMAIL="support@sevolf.store"

# Supabase Integration (Server & Client)
# Project URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Payment Gateways (India First & Global)
# Razorpay Credentials (for INR, UPI, Cards)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe Credentials (for USD, EUR, GBP International Cards)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Asset Storage Encryption & Bucket
PRIVATE_ASSET_BUCKET="digital-products"

# Master Bearer Token Encryption Key (AES-256-GCM 32-byte Hex or Passphrase)
# Rotate by setting TOKEN_ENCRYPTION_KEY_V2 when updating keys
TOKEN_ENCRYPTION_KEY_V1=your_64_character_hex_or_passphrase_here

# Transactional Email Dispatcher (Resend)
RESEND_API_KEY=re_your_resend_api_key

# Background Delivery Worker Security Header
WORKER_SECRET=your_internal_cron_secret_token_here
